major_diseases <- pair_disease_by_paper |>
semi_join(
top_interfaces,
by = c("wildlife_host_group", "domestic_host_group")
) |>
distinct(paper_id, disease_harmonised) |>
count(disease_harmonised, name = "papers_across_displayed_interfaces") |>
arrange(desc(papers_across_displayed_interfaces), disease_harmonised) |>
slice_head(n = n_top_diseases)
panel_b_data <- panel_b_all_diseases |>
semi_join(major_diseases, by = "disease_harmonised") |>
mutate(
interface_label = factor(
interface_label,
levels = rev(top_interfaces$interface_label)
)
)
# Disease order: most represented across displayed interfaces first.
disease_order <- major_diseases$disease_harmonised
panel_b_data <- panel_b_data |>
mutate(
disease_harmonised = factor(
disease_harmonised,
levels = disease_order
)
)
# ------------------------------------------------------------
# 9. Panel A
# ------------------------------------------------------------
# Colour = number of UNIQUE studies containing both host groups.
# No disease information is forced into this panel.
max_studies <- max(panel_a_data$n_studies, na.rm = TRUE)
panel_a <- ggplot(
panel_a_data,
aes(
x = domestic_host_group,
y = wildlife_host_group
)
) +
geom_tile(
aes(fill = n_studies),
colour = "white",
linewidth = 0.65
) +
scale_fill_gradientn(
colours = c(
"#F4EBD8",  # pale sand
"#D9E7C3",  # light meadow
"#A9C89B",  # soft green
"#789C72",  # muted forest
"#536F55"   # deep terrain green
),
values = scales::rescale(c(0, 0.10, 0.30, 0.60, 1)),
trans = "sqrt",
name = "Publications",
breaks = pretty(c(0, max_studies), n = 5)
) +
labs(
title = "A",
#subtitle = "Study representation across wildlife–domestic host-group combinations"
,
x = "Domestic-associated group",
y = "Wildlife-associated group"
) +
theme_minimal(base_size = 13) +
theme(
panel.grid = element_blank(),
axis.text.x = ggtext::element_markdown(
angle = 50,
hjust = 1,
vjust = 1,
size = 11,
colour = "#4E4637",
fill = "#FFF1B8",
box.colour = NA,
linetype = 0,
r = unit(2.5, "pt"),
padding = margin(3, 4.5, 3, 4.5)
),
axis.text.y = ggtext::element_markdown(
size = 11,
colour = "#34463A",
fill = "#DCEED7",
box.colour = NA,
linetype = 0,
r = unit(2.5, "pt"),
padding = margin(3, 4.5, 3, 4.5)
),
axis.title.x = element_text(
face = "bold",
size = 13,
margin = margin(t = 12)
),
axis.title.y = element_text(
face = "bold",
size = 13,
margin = margin(r = 10)
),
plot.title = element_text(
face = "bold",
size = 16
),
legend.position = "bottom",
legend.title = element_text(size = 11),
legend.text = element_text(size = 10)
) +
guides(
fill = guide_colourbar(
title.position = "top",
title.hjust = 0.5,
barwidth = unit(10, "cm"),
barheight = unit(0.5, "cm")
)
)
# ------------------------------------------------------------
# 10. Panel B
# ------------------------------------------------------------
# Rows = major host combinations
# Columns = major harmonised disease systems
# Dot size = number of UNIQUE papers containing that host combination
#            and disease system.
#
# IMPORTANT:
# The wildlife/domestic labels are drawn as separate geom_label()
# columns rather than HTML inside an axis label. This is much more
# stable and gives clean, independently coloured label boxes.
# Explicit numeric positions make the label columns predictable.
interface_positions <- top_interfaces |>
mutate(
interface_y = rev(seq_len(n()))
)
disease_positions <- tibble(
disease_harmonised = disease_order,
disease_x = seq_along(disease_order)
)
panel_b_plot_data <- panel_b_all_diseases |>
semi_join(major_diseases, by = "disease_harmonised") |>
left_join(
interface_positions |>
select(
wildlife_host_group,
domestic_host_group,
interface_label,
interface_y
),
by = c(
"wildlife_host_group",
"domestic_host_group",
"interface_label"
)
) |>
left_join(
disease_positions,
by = "disease_harmonised"
)
# Coordinates for the two host-label columns.
# These sit to the LEFT of the first disease column.
wild_label_x <- -4.2
cross_x      <- -2.85
dom_label_x  <- -2.55
panel_b <- ggplot() +
# Disease dots
geom_point(
data = panel_b_plot_data,
aes(
x = disease_x,
y = interface_y,
size = disease_papers_n,
colour = review_prop
)
) +
scale_colour_gradient(
low = "#3B82A0",
high = "#D66B63",
limits = c(0, 1),
labels = scales::percent,
name = "Reviews (%)"
) +
# Wildlife label: pastel green, bold, right-aligned
geom_label(
data = interface_positions,
aes(
x = wild_label_x,
y = interface_y,
label = wildlife_host_group
),
inherit.aes = FALSE,
fill = "#DCEED7",
colour = "#34463A",
fontface = "bold",
label.size = 0,
label.padding = unit(0.18, "lines"),
hjust = 1,
size = 4
) +
# Multiplication sign between the two host domains
geom_text(
data = interface_positions,
aes(
x = cross_x,
y = interface_y,
label = "\u00d7"
),
inherit.aes = FALSE,
colour = "#7A7467",
size = 4
) +
# Domestic label: light yellow, bold, left-aligned
geom_label(
data = interface_positions,
aes(
x = dom_label_x,
y = interface_y,
label = domestic_host_group
),
inherit.aes = FALSE,
fill = "#FFF1B8",
colour = "#4E4637",
fontface = "bold",
label.size = 0,
label.padding = unit(0.18, "lines"),
hjust = 0,
size = 3.1
) +
scale_size_area(
max_size = 12,
name = "Publications"
) +
# Disease labels remain the x-axis categories.
scale_x_continuous(
breaks = disease_positions$disease_x,
labels = disease_positions$disease_harmonised,
limits = c(-5.8, max(disease_positions$disease_x) + 0.5),
expand = expansion(mult = c(0, 0))
) +
scale_y_continuous(
breaks = interface_positions$interface_y,
labels = NULL,
limits = c(0.5, nrow(interface_positions) + 0.5),
expand = c(0, 0)
) +
# Host labels are now inside the x scale; clipping is kept off only
# as a safeguard for label-box edges.
coord_cartesian(clip = "off") +
labs(
title = "B", #Disease systems within major interfaces
#subtitle = paste0(
# "Top ", n_top_interfaces,
#" host combinations and top ", n_top_diseases,
#" disease systems shown")
,
x = "Disease system",
y = NULL
) +
theme_minimal(base_size = 12) +
theme(
panel.grid.minor = element_blank(),
panel.grid.major.y = element_line(
linewidth = 0.25,
colour = "grey88"
),
panel.grid.major.x = element_line(
linewidth = 0.25,
colour = "grey90"
),
axis.text.x = element_text(
angle = 50,
hjust = 1,
vjust = 1,
size = 9.5,
colour = "#3F3F3F"
),
axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
axis.title.x = element_text(face = "bold"),
plot.title = element_text(face = "bold", size = 14),
plot.subtitle = element_text(size = 9.5),
legend.position = "bottom",
# Deliberately generous left margin for the two host-label columns.
plot.margin = margin(
t = 8,
r = 10,
b = 8,
l = 10,
unit = "pt"
)
)
# ------------------------------------------------------------
# 11. Export individual panels
# ------------------------------------------------------------
panel_a_file <- file.path(
results_dir,
paste0(final_prefix, "_interface_panel_A_heatmap.png")
)
panel_b_file <- file.path(
results_dir,
paste0(final_prefix, "_interface_panel_B_diseases.png")
)
ggsave(
panel_a_file,
panel_a,
width = 13.5,
height = 8.5,
dpi = 400,
bg = "white"
)
ggsave(
panel_b_file,
panel_b,
width = 13.5,
height = 7.5,
dpi = 400,
bg = "white"
)
# ------------------------------------------------------------
# 12. Combined A + B figure
# ------------------------------------------------------------
# patchwork is used only for figure assembly.
if (!requireNamespace("patchwork", quietly = TRUE)) {
stop(
"Package 'patchwork' is required for the combined figure. ",
"Install it with install.packages('patchwork'). ",
"The individual panels can still be produced without it."
)
}
combined_figure <- panel_a / panel_b +
patchwork::plot_layout(heights = c(1.08, 1)) +
patchwork::plot_annotation(
title = "",
#caption = paste(
# "Panel A: colour indicates the number of unique studies containing each wildlife–domestic host-group combination.",
#  "Panel B: dot size indicates the number of unique papers in which the displayed host combination and disease system co-occur.",
# "Co-occurrence within a study does not necessarily demonstrate direct transmission between the host groups.")
,
theme = theme(
plot.title = element_text(face = "bold", size = 16),
plot.caption = element_text(size = 8.5, hjust = 0)
)
)
combined_file <- file.path(
results_dir,
paste0(final_prefix, "_Figure_04.png")
)
ggsave(
combined_file,
combined_figure,
width = 15,
height = 16,
dpi = 400,
bg = "white"
)
#---------------------------------------------------------------------------------
# Reality check of the interfaces
panel_b_data |>
filter(
str_detect(
as.character(disease_harmonised),
regex("African swine fever|ASF", ignore_case = TRUE)
)
) |>
print(n = Inf)
asf_records <- disease_harmonised |>
filter(
if_any(
where(is.character),
~ str_detect(
coalesce(.x, ""),
regex("African swine fever|ASF", ignore_case = TRUE)
)
)
)
bird_pairs <- interface_pairs_by_paper |>
filter(
wildlife_host_group == "Birds",
domestic_host_group %in% c("Poultry", "Domestic waterfowl")
) |>
arrange(domestic_host_group, paper_id)
#View(bird_pairs)
# When we create pair_disease_by_paper,This joins every host pair to every disease discussed in the same publication, regardless of whether that disease was associated with those hosts.
asf_birds <- pair_disease_by_paper |>
filter(
wildlife_host_group == "Birds",
domestic_host_group %in% c("Poultry", "Domestic waterfowl"),
disease_harmonised == "African swine fever"
) |>
arrange(paper_id, domestic_host_group)
View(asf_birds)
asf_birds
asf_paper_ids <- unique(asf_birds$paper_id)
asf_audit <- tibble(paper_id = asf_paper_ids) |>
left_join(
wildlife_groups |>
filter(paper_id %in% asf_paper_ids) |>
group_by(paper_id) |>
summarise(
wildlife = paste(sort(unique(wildlife_host_group)), collapse = "; "),
.groups = "drop"
),
by = "paper_id"
) |>
left_join(
domestic_groups |>
filter(paper_id %in% asf_paper_ids) |>
group_by(paper_id) |>
summarise(
domestic = paste(sort(unique(domestic_host_group)), collapse = "; "),
.groups = "drop"
),
by = "paper_id"
) |>
left_join(
disease_by_paper |>
filter(paper_id %in% asf_paper_ids) |>
group_by(paper_id) |>
summarise(
diseases = paste(sort(unique(disease_harmonised)), collapse = "; "),
.groups = "drop"
),
by = "paper_id"
)
View(asf_audit)
asf_audit$paper_id
asf_audit_with_type <- asf_audit |>
left_join(
paper_summary |>
select(paper_id, study_type),
by = "paper_id"
)
asf_audit_with_type
asf_audit_with_type$paper_id
#CDV in birds
disease_by_paper |>
filter(str_detect(
disease_harmonised,
regex("distemper", ignore_case = TRUE)
)) |>
count(disease_harmonised)
cdv_birds <- pair_disease_by_paper |>
filter(
wildlife_host_group == "Birds",
str_detect(
disease_harmonised,
regex("canine distemper", ignore_case = TRUE)
)
) |>
arrange(paper_id, domestic_host_group)
View(cdv_birds)
cdv_birds
cdv_paper_ids <- unique(cdv_birds$paper_id)
cdv_audit <- tibble(paper_id = cdv_paper_ids) |>
left_join(
wildlife_groups |>
filter(paper_id %in% cdv_paper_ids) |>
group_by(paper_id) |>
summarise(
wildlife = paste(sort(unique(wildlife_host_group)), collapse = "; "),
.groups = "drop"
),
by = "paper_id"
) |>
left_join(
domestic_groups |>
filter(paper_id %in% cdv_paper_ids) |>
group_by(paper_id) |>
summarise(
domestic = paste(sort(unique(domestic_host_group)), collapse = "; "),
.groups = "drop"
),
by = "paper_id"
) |>
left_join(
disease_by_paper |>
filter(paper_id %in% cdv_paper_ids) |>
group_by(paper_id) |>
summarise(
diseases = paste(sort(unique(disease_harmonised)), collapse = "; "),
.groups = "drop"
),
by = "paper_id"
)
cdv_audit
cdv_birds |>
count(domestic_host_group, name = "n_papers", sort = TRUE)
cdv_birds |>
count(domestic_host_group, name = "n_papers", sort = TRUE)
cdv_audit_with_type <- cdv_audit |>
left_join(
paper_summary |>
select(paper_id, study_type),
by = "paper_id"
)
cdv_audit_with_type$paper_id
# Papers discussing CDV and also discussing birds ("a379" "a569" "a67" ) are all reviews
# Papers discussing ASF and also discussing birds ("a10"  "a122" "a379" "a67"  "a888") are all reviews too
panel_b_data |>
filter(
wildlife_host_group == "Birds",
grepl(
"African swine fever|Canine distemper",
as.character(disease_harmonised),
ignore.case = TRUE
)
) |>
select(
wildlife_host_group,
domestic_host_group,
disease_harmonised,
disease_papers_n,
review_n,
review_prop
) |>
print(n = Inf)
