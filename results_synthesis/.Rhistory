}
quantitative_long <- if (file_exists(quantitative_file)) {
read_csv(quantitative_file, show_col_types = FALSE)
} else {
tibble()
}
# ------------------------------------------------------------
# Main one-row-per-paper table
# ------------------------------------------------------------
paper_summary_table <- papers |>
transmute(
paper_id = article_id,
master_record_id,
author = Author,
title = Title,
journal = Journal,
doi = DOI,
metadata_join_status,
study_type,
study_design,
country = countries_investigated,
animal_focus,
wildlife_role,
domestic_role,
wildlife_taxa,
domestic_taxa,
diseases_or_pathogens,
disease_agent_types,
transmission_modes,
host_orientation,
host_orientation_label,
interface_operationalisation,
interface_label,
interface_explicit,
quantitative_interface_measures_n,
quantitative_interface_measure_names
)
# ------------------------------------------------------------
# Frequency summaries
# ------------------------------------------------------------
study_type_counts <- papers |>
count(study_type, sort = TRUE, name = "n") |>
mutate(percent = round(100 * n / sum(n), 1))
animal_focus_counts <- papers |>
count(animal_focus, sort = TRUE, name = "n") |>
mutate(percent = round(100 * n / sum(n), 1))
split_semicolon_counts <- function(data, column, output_name) {
data |>
select(value = all_of(column)) |>
filter(!is.na(value), nzchar(value)) |>
separate_rows(value, sep = ";\\s*") |>
mutate(value = str_squish(value)) |>
filter(nzchar(value)) |>
count(value, sort = TRUE, name = "n") |>
rename(!!output_name := value)
}
wildlife_taxa_counts <- split_semicolon_counts(
papers, "wildlife_taxa", "wildlife_taxon"
)
domestic_taxa_counts <- split_semicolon_counts(
papers, "domestic_taxa", "domestic_taxon"
)
wildlife_species_counts <- split_semicolon_counts(
papers, "wildlife_species", "wildlife_species"
)
domestic_species_counts <- split_semicolon_counts(
papers, "domestic_species", "domestic_species"
)
if (nrow(disease_long) > 0) {
disease_counts <- disease_long |>
filter(!is.na(disease), nzchar(disease)) |>
distinct(article_id, disease) |>
count(disease, sort = TRUE, name = "papers_n")
agent_type_counts <- disease_long |>
filter(!is.na(agent_type), nzchar(agent_type)) |>
distinct(article_id, agent_type) |>
count(agent_type, sort = TRUE, name = "papers_n")
transmission_counts <- disease_long |>
filter(!is.na(transmission_mode), nzchar(transmission_mode)) |>
distinct(article_id, transmission_mode) |>
count(transmission_mode, sort = TRUE, name = "papers_n")
} else {
disease_counts <- tibble()
agent_type_counts <- tibble()
transmission_counts <- tibble()
}
# ------------------------------------------------------------
# Quantitative interface measures
# ------------------------------------------------------------
if (nrow(quantitative_long) > 0) {
quantitative_measures_table <- quantitative_long |>
left_join(
papers |>
select(
article_id,
Author,
Title,
Journal,
DOI,
study_type,
animal_focus,
host_orientation,
interface_operationalisation
),
by = "article_id"
) |>
transmute(
paper_id = article_id,
author = Author,
title = Title,
journal = Journal,
doi = DOI,
study_type,
animal_focus,
host_orientation,
interface_operationalisation,
measure_name,
what_it_represents,
measurement_method,
metric_or_unit,
role_in_analysis,
quantitative_result,
evidence_quote,
page,
section,
grounding_status
) |>
arrange(
desc(interface_operationalisation),
measure_name
)
quantitative_measure_counts <- quantitative_long |>
filter(!is.na(measure_name), nzchar(measure_name)) |>
distinct(article_id, measure_name) |>
count(measure_name, sort = TRUE, name = "papers_n")
quantitative_role_counts <- quantitative_long |>
filter(!is.na(role_in_analysis), nzchar(role_in_analysis)) |>
mutate(
role_in_analysis = str_to_lower(str_squish(role_in_analysis))
) |>
distinct(article_id, role_in_analysis) |>
count(role_in_analysis, sort = TRUE, name = "papers_n")
quantitative_method_counts <- quantitative_long |>
filter(
!is.na(measurement_method),
nzchar(measurement_method)
) |>
mutate(
measurement_method = str_squish(measurement_method)
) |>
distinct(article_id, measurement_method) |>
count(
measurement_method,
sort = TRUE,
name = "papers_n"
)
} else {
quantitative_measures_table <- tibble()
quantitative_measure_counts <- tibble()
quantitative_role_counts <- tibble()
quantitative_method_counts <- tibble()
}
# ------------------------------------------------------------
# Compact manuscript-level summary
# ------------------------------------------------------------
manuscript_summary <- tibble(
characteristic = c(
"Number of papers",
"Wildlife focus",
"Domestic focus",
"Both wildlife and domestic"
),
value = c(
nrow(papers),
sum(papers$animal_focus == "Wildlife", na.rm = TRUE),
sum(papers$animal_focus == "Domestic", na.rm = TRUE),
sum(papers$animal_focus == "Both", na.rm = TRUE)
)
)
output_xlsx <- file.path(
results_dir,
paste0(final_prefix, "_manuscript_summary_tables.xlsx")
)
write.xlsx(
list(
manuscript_summary = manuscript_summary,
paper_summary = paper_summary_table,
study_type_counts = study_type_counts,
animal_focus_counts = animal_focus_counts,
disease_counts = disease_counts,
agent_type_counts = agent_type_counts,
transmission_counts = transmission_counts,
quantitative_measures = quantitative_measures_table,
quantitative_measure_counts = quantitative_measure_counts,
quantitative_role_counts = quantitative_role_counts,
quantitative_method_counts = quantitative_method_counts,
wildlife_taxa_counts = wildlife_taxa_counts,
domestic_taxa_counts = domestic_taxa_counts,
wildlife_species_detail = wildlife_species_counts,
domestic_species_detail = domestic_species_counts
),
file = output_xlsx,
overwrite = TRUE
)
message("Saved manuscript summary workbook: ", output_xlsx)
setwd('results_synthesis')
getwd()
setwd('../results_synthesis')
library(readxl)
library(dplyr)
library(stringr)
library(purrr)
library(tidyr)
library(tibble)
file <- "evidence_first_test_manuscript_summary_tables.xlsx"
qm <- read_excel(
file,
sheet = "quantitative_measures"
)
# Basic checks
nrow(qm)
n_distinct(qm$paper_id)
# ============================================================
# 2. TEXT USED FOR CLASSIFICATION
# ============================================================
# Use the available descriptions of each quantitative measure.
# This gives more evidence than classifying from measure_name alone.
qm <- qm %>%
mutate(
classification_text = str_to_lower(
paste(
coalesce(measure_name, ""),
coalesce(what_it_represents, ""),
coalesce(measurement_method, ""),
coalesce(role_in_analysis, ""),
sep = " | "
)
)
)
# ============================================================
# 3. HIGH-LEVEL INTERFACE DIMENSIONS
# ============================================================
# Categories are NON-MUTUALLY EXCLUSIVE.
# A measure/study can therefore contribute to >1 dimension.
dimension_patterns <- list(
"Spatial proximity" = paste(
"\\bdistance\\b",
"\\bproximity\\b",
"\\bnear(?:by)?\\b",
"\\bbuffer\\b",
"\\bdistance to\\b",
"\\bproximity to\\b",
sep = "|"
),
"Spatial overlap / co-occurrence" = paste(
"\\boverlap\\b",
"\\bco-occurr?ence\\b",
"\\bco-occur\\b",
"\\bshared space\\b",
"\\bspace use\\b",
"\\bhome range\\b",
"\\bhome-range\\b",
"\\butili[sz]ation distribution\\b",
"\\bsympatr",
sep = "|"
),
"Direct/indirect contact" = paste(
"\\bcontact\\b",
"\\binteraction\\b",
"\\bencounter\\b",
"\\bcontact rate\\b",
"\\bcontact frequency\\b",
"\\bshared feeding\\b",
"\\bshared water",
"\\bshared grazing\\b",
"\\bshared resource",
"\\bshared site",
"\\bvisit(?:ation)?\\b",
sep = "|"
),
"Landscape/interface structure" = paste(
"\\blandscape\\b",
"\\bland use\\b",
"\\bland-use\\b",
"\\bhabitat\\b",
"\\bfragmentation\\b",
"\\bedge\\b",
"\\bboundary\\b",
"\\bforest cover\\b",
"\\bvegetation\\b",
"\\bpasture\\b",
"\\bagricultur",
"\\bfarm.*forest\\b",
sep = "|"
),
"Host availability / pressure" = paste(
"\\babundance\\b",
"\\bdensity\\b",
"\\bpopulation size\\b",
"\\boccupancy\\b",
"\\bherd size\\b",
"\\bstocking density\\b",
"\\bhost density\\b",
"\\blivestock density\\b",
"\\bwildlife density\\b",
sep = "|"
),
"Movement / connectivity" = paste(
"\\bmovement\\b",
"\\bmovements\\b",
"\\bdispersal\\b",
"\\bmigration\\b",
"\\bconnectivity\\b",
"\\bgps\\b",
"\\btelemetry\\b",
"\\btracking\\b",
"\\bmovement network\\b",
"\\bmovement path\\b",
sep = "|"
),
"Pathogen connectivity" = paste(
"\\bpathogen\\b",
"\\binfection\\b",
"\\bprevalence\\b",
"\\bseroprevalence\\b",
"\\bsero-prevalence\\b",
"\\bserolog",
"\\bantibod",
"\\bpcr\\b",
"\\brt-pcr\\b",
"\\bsequence\\b",
"\\bgenetic similarity\\b",
"\\bphylogen",
"\\bgenomic\\b",
"\\bstrain\\b",
"\\bgenotype\\b",
"\\btransmission\\b",
"\\bviral\\b",
"\\bvirus\\b",
"\\bparasite\\b",
"\\bbacter",
sep = "|"
),
"Human/management-mediated interface" = paste(
"\\bmanagement\\b",
"\\bhusbandry\\b",
"\\bbiosecurity\\b",
"\\bvaccin",
"\\bfeeding\\b",
"\\bgrazing\\b",
"\\bfenc",
"\\bfarming practice",
"\\bfarm management",
"\\banimal management",
"\\bfarmer",
"\\bowner",
sep = "|"
)
)
# ============================================================
# 4. CLASSIFY QUANTITATIVE MEASURES
# ============================================================
classified_measures <- imap_dfr(
dimension_patterns,
function(pattern, dimension) {
qm %>%
filter(
str_detect(
classification_text,
regex(pattern, ignore_case = TRUE)
)
) %>%
transmute(
paper_id,
interface_dimension = dimension,
measure_name,
what_it_represents,
measurement_method
)
}
)
# ============================================================
# 5. MINIMAL AUDIT TABLE
# ============================================================
# This preserves the evidence behind every classification.
interface_measure_audit <- classified_measures %>%
distinct(
interface_dimension,
paper_id,
measure_name,
what_it_represents,
measurement_method
) %>%
arrange(interface_dimension, paper_id)
# ============================================================
# 6. COUNT UNIQUE STUDIES
# ============================================================
# IMPORTANT:
# A paper with several measures in the same dimension counts ONCE.
dimension_counts <- classified_measures %>%
distinct(
interface_dimension,
paper_id
) %>%
count(
interface_dimension,
name = "N_studies"
)
# ============================================================
# 7. CLEAN MANUSCRIPT TABLE
# ============================================================
interface_structure <- tribble(
~interface_dimension,
~what_is_characterised,
~examples_of_measurements,
"Spatial proximity",
"How close wild and domestic hosts are",
"Distance to farms, distance to wildlife habitat, buffers, proximity measures",
"Spatial overlap / co-occurrence",
"Whether wild and domestic hosts use the same places",
"GPS overlap, home-range overlap, camera-trap co-occurrence, shared habitat",
"Direct/indirect contact",
"Actual or inferred encounters between host domains",
"Contact rates, proximity events, shared feeding or watering sites, observed interactions",
"Landscape/interface structure",
"Environmental configuration producing or modifying the interface",
"Habitat edges, fragmentation, land-use composition, farm-forest boundaries",
"Host availability / pressure",
"Availability or abundance of hosts on either side of the interface",
"Livestock density, wildlife abundance, herd size, occupancy",
"Movement / connectivity",
"Movement of hosts across domains or populations",
"GPS movement, telemetry, dispersal, migration, movement networks",
"Pathogen connectivity",
"Evidence of infection or pathogen links across host domains",
"Pathogen prevalence, serology, PCR detection, sequence similarity, genetic evidence",
"Human/management-mediated interface",
"Human practices that create, alter or manage wild-domestic interactions",
"Husbandry, grazing, feeding, fencing, vaccination, biosecurity"
)
interface_dimension_summary <- interface_structure %>%
left_join(
dimension_counts,
by = "interface_dimension"
) %>%
mutate(
N_studies = replace_na(N_studies, 0L)
)
# ============================================================
# 8. RESULTS
# ============================================================
print(interface_dimension_summary)
# ============================================================
# 9. QUICK AUDIT EXAMPLE
# ============================================================
# If we ever need to see which evidence generated a category:
interface_measure_audit %>%
filter(interface_dimension == "Spatial proximity")
# ============================================================
# 10. CHECK UNCLASSIFIED MEASURES
# ============================================================
# Important quality-control step:
# these are quantitative measures that did not match any category.
classified_ids <- classified_measures %>%
distinct(paper_id, measure_name)
unclassified_measures <- qm %>%
anti_join(
classified_ids,
by = c("paper_id", "measure_name")
) %>%
select(
paper_id,
measure_name,
what_it_represents,
measurement_method,
role_in_analysis
)
cat(
"\nUnclassified quantitative measures:",
nrow(unclassified_measures),
"of",
nrow(qm),
"\n"
)
View(unclassified_measures)
tribble(
~review_id, ~interface_dimension,
1, "Spatial proximity",
2, "Pathogen connectivity",
3, "Landscape/interface structure",
4, "Direct/indirect contact"
# continue for the relevant rows
)
manual_classification
View(unclassified_measures)
unclassified_review <- unclassified_measures %>%
mutate(
review_id = row_number(),
manual_interface_dimension = ""
) %>%
select(
review_id,
paper_id,
measure_name,
what_it_represents,
measurement_method,
role_in_analysis,
manual_interface_dimension
)
library(writexl)
getwd()
unclassified_review
